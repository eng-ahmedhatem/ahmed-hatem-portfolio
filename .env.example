# Public application origin
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Switch the public Next.js repository from bundled mock content to Supabase-backed content.
CONTENT_REPOSITORY=api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=portfolio-assets

# Legacy keys are accepted when a project has not migrated to the new key format:
# SUPABASE_ANON_KEY=replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Generate unique random secrets for every environment (32+ and 16+ characters).
SESSION_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_SALT=replace-with-a-separate-random-value

# Created once on the first API start. Change the password in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-12-character-password

# Optional transactional email (verified sender domain). Never expose this key publicly.
# RESEND_API_KEY=
# MAIL_FROM=notifications@your-domain.com
# CONTACT_NOTIFICATION_EMAIL=you@your-domain.com
